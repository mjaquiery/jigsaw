{
  "name": "jigsaw",
  "private": true,
  "version": "1.0.0",
  "description": "A calm, easy-to-handle jigsaw puzzle for the iPad.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check-sources": "LIVE_SOURCES=1 vitest run tests/live-sources.test.ts",
    "make-icons": "node scripts/make-icons.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
